{
  "name": "pharos-invaders-frontend",
  "version": "2.0.0",
  "description": "Pharos Invaders - Offline version with Discord authentication",
  "main": "game-config.js",
  "scripts": {
    "dev": "vite",
    "build": "npm run build:main && npm run build:tournament",
    "build:main": "cross-env vite build",
    "build:tournament": "cross-env BUILD_TARGET=tournament vite build",
    "build:watch": "vite build --watch",
    "preview": "vite preview",
    "deploy": "bash deploy.sh"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vi11abajo/PI_Offline.git"
  },
  "keywords": [
    "pharos",
    "invaders",
    "game",
    "discord"
  ],
  "author": "vi11abajo",
  "license": "ISC",
  "type": "module",
  "bugs": {
    "url": "https://github.com/vi11abajo/PI_Offline/issues"
  },
  "homepage": "https://github.com/vi11abajo/PI_Offline#readme",
  "dependencies": {
    "@coinbase/onchainkit": "^1.1.2",
    "dotenv": "^17.2.3",
    "ethers": "^6.16.0",
    "socket.io-client": "^4.6.1",
    "viem": "^2.44.4",
    "wagmi": "^2.19.5",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^6.1.0",
    "@openzeppelin/contracts": "^5.4.0",
    "@vitejs/plugin-legacy": "^7.2.1",
    "cross-env": "^10.1.0",
    "hardhat": "^3.1.5",
    "vite": "^7.1.8"
  }
}
